# ⚙️ 引擎参数集中配置（原先散落在各处的硬编码统一到此）
# ==========================================
DEEPSEEK_BASE_URL = "https://api.deepseek.com"
MODEL_ENGINE = "deepseek-v4-flash"      # 引擎 A：快速 JSON 战局推演
MODEL_STRATEGIST = "deepseek-v4-pro"    # 引擎 B：深度战略复盘
MODEL_CHAT = "deepseek-reasoner"        # 侧栏璇玑实时问答
MAX_API_RETRIES = 3                     # 坐标修正反思循环上限

# 🛡️ 模型回退链：若 MODEL_* 常量在你的账号下不存在（API 返回 400 model not exist），
#    系统会自动降级到下列稳定模型名，而不是让整条推演链直接崩掉。
MODEL_FALLBACKS = {
    MODEL_ENGINE: ["deepseek-chat"],
    MODEL_STRATEGIST: ["deepseek-reasoner", "deepseek-chat"],
    MODEL_CHAT: ["deepseek-chat"],
}
_MODEL_DEGRADED = set()   # 已确认失效的模型，后续直接走回退，避免每回合都撞一次 400


def _looks_like_model_error(exc):
    """区分「模型名不存在」与「网络/鉴权/配额」等不该回退的错误。"""
    text = str(exc).lower()
    return "model" in text and any(
        k in text for k in ("not exist", "does not exist", "invalid", "unknown", "not found"))


def chat_completion(client, model, messages, **kwargs):
    """统一模型调用入口：主模型失效时自动回退，保证推演链不因模型名写错而全挂。"""
    chain = [model] if model in _MODEL_DEGRADED else [model] + MODEL_FALLBACKS.get(model, [])
    last_exc = None
    for idx, m in enumerate(chain):
        try:
            resp = client.chat.completions.create(model=m, messages=messages, **kwargs)
            if idx > 0:
                _MODEL_DEGRADED.add(model)
                st.warning(f"⚠️ 模型 `{model}` 不可用，已自动回退至 `{m}`。"
                           f"建议在文件顶部配置区修正 MODEL_* 常量。")
            return resp
        except Exception as exc:
            last_exc = exc
            if not _looks_like_model_error(exc):
                raise      # 鉴权/网络/配额问题原样抛出，别用回退掩盖真实故障
    raise last_exc

# 海军单位判定关键词（原先在 3 处重复实现，口径易漂移）
NAVAL_KEYWORDS = ['舰', '船', '航母', '潜艇', 'ship', 'carrier',
                  'submarine', 'cruiser', 'destroyer', 'fleet']


def is_naval(unit_type):
    """统一的「是否海军单位」判定。"""
    return any(k in str(unit_type).lower() for k in NAVAL_KEYWORDS)


def to_float(value):
    """安全数值转换：失败返回 None，避免坐标异常把整次推演拖崩。"""
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


